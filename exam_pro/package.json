{
  "name": "tutor-exam-bank",
  "version": "1.0.0",
  "description": "家教專用數學物理題庫系統 - 企業級重構版",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed_questions.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --env-file=eval/.env.replay --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "eval": "node --env-file=eval/.env.replay eval/run.js",
    "eval:retrieval": "npm run eval -- --suite retrieval",
    "eval:baseline": "npm run eval -- --suite retrieval --write-baseline",
    "eval:trend": "node eval/trend.js",
    "eval:golden": "node eval/tools/suggest_golden.js",
    "eval:record": "node eval/record_embeddings.js",
    "embed:backfill": "node scripts/backfill_embeddings.js",
    "embed:backfill:test": "node scripts/backfill_embeddings.js --test",
    "migrate": "node migrate.js up",
    "migrate:test": "node migrate.js up --test",
    "migrate:import": "node migrate/import_pg.js",
    "migrate:verify": "node migrate/verify.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:backup": "node scripts/backup.js"
  },
  "keywords": [
    "exam-bank",
    "express",
    "postgresql",
    "gemini",
    "latex",
    "docx",
    "pgvector"
  ],
  "author": "Ben Yang (楊本顥)",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@node-rs/jieba": "^2.0.2",
    "ajv": "^8.20.0",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pdfkit": "^0.15.2",
    "supertest": "^7.2.2"
  }
}
