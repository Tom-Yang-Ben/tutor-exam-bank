{
  "name": "tutor-exam-bank",
  "version": "1.0.0",
  "description": "家教專用數學物理題庫系統 - 企業級重構版",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed_questions.js",
    "test": "node --test",
    "migrate": "node migrate.js up",
    "migrate:test": "node migrate.js up --test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "keywords": [
    "exam-bank",
    "express",
    "mysql",
    "gemini",
    "latex",
    "docx"
  ],
  "author": "Ben Yang (楊本顥)",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
