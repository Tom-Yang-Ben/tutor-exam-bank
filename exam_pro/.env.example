# 複製此檔為 .env 並填入實際值
# 變數清單的權威版本：階段 1 在 docs/interfaces.md 第 9 條（I0），階段 2 在
# docs/interfaces-stage2.md 第 9 條（I0'）；本機模式在 docs/local-mode.md 第 2 條。
# 各 workstream 不要直接改這個檔：需要新變數請寫在 PR 描述裡，由開發者本人合入。
PORT=3000

# 後端聽哪個網路位址（〔Owner 第六輪 DA-11＝1，2026-09-27〕config/listenHost.js）。
# 不寫＝127.0.0.1：只有這台電腦打得開 http://localhost:3000（預設，建議維持）。
# 要讓同一個 Wi-Fi 的平板、手機也連得到，才把下面這一行的 # 拿掉（exam_pro/README.md「區網存取」）：
#   1. Windows 防火牆只允許「私人網路」存取 Node.js，不要勾「公用網路」（咖啡店、學校的 Wi-Fi 都是公用）；
#   2. ALLOWED_ORIGINS 要加上 http://<這台電腦的區網 IP>:3000，否則從平板送出的操作會被 CORS 擋下；
#   3. API_KEY 會注入首頁，連得到首頁的人就拿得到它，它不是存取控制：區網裡的任何人都能看題庫與學生資料。
# 桌面啟動器（出題系統圖示）支援不寫、127.0.0.1、localhost、::1、0.0.0.0、::；其他值（某一個區網位址、127.0.0.1 以外的 127.x）
# 會讓 app 視窗的 http://localhost 連不到後端，啟動器會停下說明。
# HOST=0.0.0.0

# ══════════════════════════════════════════════════════════════
# 本機模式（docs/local-mode.md；2026-09-25 起的預設）
# ══════════════════════════════════════════════════════════════
# 模型都跑在這台電腦上（Ollama 的 Qwen3 系列＋PaddleOCR），執行期不連外、不產生任何費用；
# 代價是 CPU 上很慢、品質低於 Gemini（見 docs/local-mode.md 第 10 條）。
# 第一次使用：雙擊 exam_pro\scripts\windows\setup_local_ai.bat（檢查 Ollama、下載三個模型、安裝 PaddleOCR）。
# 要讓伺服器真的呼叫模型，把下面「Embedding 與檢索」段的 LLM_MODE／EMBED_MODE 改成 live
# （範本預設 replay／fixture：只回放錄好的結果，什麼模型都不呼叫，沒裝 Ollama 也跑得起來）。
#
# ── 切回 Gemini：改這幾行就好（其他設定不用動）─────────────────
#   GEMINI_API_KEY=你的金鑰
#   MODEL_EXTRACT=gemini:gemini-3.5-flash
#   MODEL_VERIFY=gemini:gemini-3.1-pro-preview
#   MODEL_NLQ=gemini:gemini-3.5-flash
#   EMBED_MODEL=gemini-embedding-001
#     ↑ 換 embedding 模型＝全部題目的向量都要重算：npm run embed:backfill（全量對帳）→ npm run search:reindex
#   JOB_CONCURRENCY=2（選填；本機模式建議 1）
#   JOB_PDF_CHUNK_PAGES、JOB_NODE_TIMEOUT_MS 保持註解：拆題模型是 Gemini 時自動回到 20 頁、120000 毫秒。
#   OLLAMA_*、OCR_* 在 Gemini 模式下不會被讀到，留著無妨；要用語音（FEATURE_VOICE）只能在 Gemini 模式。
#   CI 讀哪一組模型的回放檔不看 .env，看 .github/workflows/ci.yml（要跟著換就得用 Gemini 重錄，會花錢）。
# 反過來從 Gemini 換成本機（舊 .env 通常明寫了 Gemini 的值）：把同樣四行改成
#   MODEL_EXTRACT=ollama:qwen3-vl:8b、MODEL_VERIFY=ollama:qwen3:8b、MODEL_NLQ=ollama:qwen3:8b、EMBED_MODEL=ollama:qwen3-embedding:0.6b，
#   刪掉（或註解掉）JOB_PDF_CHUNK_PAGES、JOB_NODE_TIMEOUT_MS 兩行，再照上面換 embedding 的兩個指令重算向量。

# Google Gemini API 金鑰：本機模式不需要，留空；切回 Gemini 才填
GEMINI_API_KEY=

# ── PostgreSQL（階段 1 起的正式資料庫）────────────────────────
# 帳密與埠對應 exam_pro/docker-compose.yml；雙擊 啟動資料庫.bat 就會起這兩個容器。
# 埠是 5442 不是 5432：本機另有一個原生 PostgreSQL 17 服務占用 5432（詳見 docker-compose.yml 註解）。
DATABASE_URL=postgres://exam:exam@localhost:5442/tutor_exam_bank
# 整合測試專用（埠 5433，tmpfs）。防呆：資料庫名必須以 _test 結尾，否則 migrate.js 拒絕執行。
TEST_DATABASE_URL=postgres://exam:exam@localhost:5433/tutor_exam_bank_test

# ── Embedding 與檢索 ────────────────────────────────────────
# 有 vendor: 前綴才走該供應商；沒有前綴的舊值（gemini-embedding-001）一律視為 Gemini，舊 .env 不必改就維持原行為。
# ⚠ 換 embedding 模型＝全部題目的向量都要重算（新舊模型的向量不能互相比）：
#    npm run embed:backfill（全量對帳，模型不同的題都會重算；本機免費但慢）→ npm run search:reindex
EMBED_MODEL=ollama:qwen3-embedding:0.6b
# EMBED_DIM 在 I0 釘死為 768（migrations/0002_vector.sql 寫死 vector(768)）。
# 要改維度＝換模型：必須新開一支 migration + 重建索引 + 全量重算。
# Qwen3-Embedding 支援自訂維度：送 dimensions=768，回傳維度不符就截前 768 維再正規化（docs/local-mode.md 第 2 條）。
EMBED_DIM=768
EMBED_RPM=60
EMBED_BATCH=32
# live=真的呼叫模型（本機模式呼叫 Ollama）／record=呼叫並錄成 fixture／fixture=只查 eval/fixtures（CI 恆為 fixture）
EMBED_MODE=fixture
# live=真的呼叫／record=呼叫並錄 cassette／replay=只回放（CI 恆為 replay）
LLM_MODE=replay

# fixture 向量檔目錄（單元測試會把它指到暫存目錄；一般不用改）
EMBED_FIXTURE_DIR=
# 指到本機 dict.txt.big 才額外載入 jieba 繁體大詞典；預設不啟用（CI 也沒有，兩邊必須一致）
JIEBA_DICT_BIG=

# ── Ollama（本機模型伺服器；docs/local-mode.md 第 2、3 條）──────────
# 只該指向本機（localhost／127.0.0.1／::1）；指到別台主機時伺服器啟動會警告（本機模式原則：執行期不連外）
OLLAMA_HOST=http://127.0.0.1:11434
# 同時送給 Ollama 的請求數；CPU 一次只跑得動一個模型，維持 1
OLLAMA_CONCURRENCY=1
# 每分鐘請求上限；不設＝不限（本機不需要限速）
#OLLAMA_RPM=30
# 單次呼叫逾時（毫秒）；CPU 上一次拆題可能要十幾分鐘，預設 30 分。
# 實機上看圖拆題一塊 2 頁可能超過 30 分：先 npm run local:bench-vision 量一頁，再照 docs/local-mode.md 第 10.11 條決定要不要調大
#（調大時 JOB_NODE_TIMEOUT_MS 也要一起調：一個節點＝OCR＋看圖＋OCR 整理依序跑）
OLLAMA_TIMEOUT_MS=1800000
# 上下文長度（Ollama 的 num_ctx）：章節白名單＋例句＋題目要放得下。
# 記憶體不足時可以降到 8192，但長的題目或多頁的塊可能被截斷
OLLAMA_NUM_CTX=16384
# 模型用完後在記憶體裡保留多久；記憶體吃緊時改 2m（或 0＝用完就卸載，下一次呼叫要重新載入，更慢）
OLLAMA_KEEP_ALIVE=10m
# 長呼叫的進度（毫秒）：設了就改用串流，每隔這麼久在伺服器視窗印一行「已輸出 N token」或「還沒輸出第一個 token（讀圖中）」，
# 分得出慢還是卡住；拆出來的結果與不設時完全相同。不設＝不印（docs/local-mode.md 第 10.11 條）。
#OLLAMA_PROGRESS_MS=300000
# （加速選項，docs/local-mode.md 第 10.14 條；Owner 第五輪決定見 10.17）量測：npm run local:bench-text -- --agent lint --no-think
# 〔Owner 第五輪 C-b、C-c〕本機模式（模型是 ollama:…）的程式預設：知識點標註（kc_tag）不思考、驗算（verify）輸出上限 3072；
# 〔Owner 第七輪 R7-1〕變式生成（variant）輸出上限 1024。
# 下面幾行不寫＝用這個預設；寫了就取代預設（Gemini 模式一律不讀）。
#   OLLAMA_NO_THINK：這些步驟在本機模式不思考（逗號分隔；lint＝公式重寫、kc_tag＝知識點標註、verify＝驗算、tutor＝AI 家教；all＝全部；
#     none＝一個都不關）。不寫＝kc_tag（本機預設）。寫了就整個取代預設：只寫 lint 的話 kc_tag 會恢復思考，要兩個都關寫 lint,kc_tag；
#     要 kc_tag 也照舊思考寫 none。verify 是獨立驗算，不思考時算錯的題會變多（Owner 第五輪 C-c 維持思考）。
#OLLAMA_NO_THINK=kc_tag
#   OLLAMA_MAX_OUTPUT_<步驟>：這一步的輸出上限（含思考）只降不升。驗算不寫＝3072（本機預設；平常不到 1,300，只縮短思考繞圈時的最壞情況）；
#     寫 8192（原本的上限）＝取消預設。寫到上限被截斷的回應在本機模式不重試、直接進人工複核（複核原因「本機模型回應被截斷」，C-f）。
#OLLAMA_MAX_OUTPUT_VERIFY=3072
#     〔Owner 第七輪 R7-1〕變式生成（variant，化學版 variant_chem 一起）不寫＝1024（本機預設；實錄 59 支中位 175、最多 358 token，
#     只擋模型陷入重複迴圈寫不停的情況）；寫 8192 以上＝取消預設（與之前一樣不設上限）。被截斷的那一題不重試、直接放棄並記事件
#     （docs/local-mode.md 10.24）。
#OLLAMA_MAX_OUTPUT_VARIANT=1024
#   OLLAMA_NUM_CTX_<步驟>：這一步自己的 num_ctx。全域降到 8192 時，拆題（看圖、OCR 整理）要保留 16384（一頁就讀寫約 8,000 token）
#OLLAMA_NUM_CTX_EXTRACT_VISION=16384
#OLLAMA_NUM_CTX_EXTRACT_OCR=16384
#     OCR 整理「放不放得下／有沒有被截斷」的判斷與警告照這一步實際送出的 num_ctx 與輸出上限算（docs/local-mode.md 10.12 第 6 點）；
#     全域降到 8192 卻漏寫上一行時，OCR 整理真的只剩 8192，每塊都會被標截斷、附圖不自動配。
#   OLLAMA_TIMEOUT_MS_<步驟>：這一步自己的單次逾時（毫秒）。〔Owner 2026-10-02 同意〕公式檢查（lint）與驗算（verify）不寫＝30 分鐘
#     （本機預設；上面的 OLLAMA_TIMEOUT_MS 為了拆題調大時，這兩步仍只等 30 分；OLLAMA_TIMEOUT_MS 本身更短時照它）。
#     這兩步逾時在本機模式不重試、直接進人工複核（docs/local-mode.md 10.25）。要多等就寫大一點，例 3600000＝60 分。
#OLLAMA_TIMEOUT_MS_LINT=1800000
#OLLAMA_TIMEOUT_MS_VERIFY=1800000
#   伺服器啟動（LLM_MODE=live）會印一行「[ollama] 本機調整…」（文字模型是 ollama 時連本機預設一起列）；名稱寫錯（例 verfy）會另外警告，不會被默默忽略。
# 另外建議在 Windows 的「使用者環境變數」設 OLLAMA_MAX_LOADED_MODELS=1（給 Ollama 伺服器看，不是給本系統）：
# 16 GB 記憶體一次只放一個大模型，設好後要從工作列圖示結束 Ollama 再重新開啟。

# ── 本機拆題的方式（〔OCR 為主 2026-09-26〕docs/local-mode.md 10.12；拆題模型是 ollama 時才有作用）──
#   ocr   ＝只用 PaddleOCR＋文字模型（qwen3:8b）整理，不呼叫看圖模型。Owner 的電腦（純 CPU）選這個：
#           看圖模型看 1 頁要 54 分鐘，OCR 整份樣卷約 4 分鐘。代價：沒有第二版可以比對，每一題都停在人工複核
#           （原因「只用 OCR 拆題」），附圖依 OCR 的版面位置自動配、配不到的標「疑似有圖未配到」（可用 figures:backfill 補）。
#   cross ＝PaddleOCR 與看圖模型各拆一次、交叉比對。有獨立顯示卡、看圖一頁幾分鐘就跑得完時用；要用一定要明寫 cross。
# 〔Owner 第五輪 D-3 核准 2026-09-27〕程式預設（這一行不寫、寫錯字時）也是 ocr，與本範本一致（docs/local-mode.md 10.19）；
#   舊的 .env 沒有這一行也會走 ocr。拆題模型是 Gemini 時完全不讀這一行。伺服器啟動時「jobRunner 啟動」那一行會印實際用哪一種。
# 與 OCR_ENGINE=none 同時成立（包括「只寫 OCR_ENGINE=none、沒寫這一行」）是矛盾設定：伺服器啟動時就報錯（ocr 模式一定要 OCR）；
#   要只用看圖模型、不做 OCR，就把這一行改成 LOCAL_EXTRACT_MODE=cross。
LOCAL_EXTRACT_MODE=ocr

# ── 本機 OCR（PaddleOCR，與視覺模型交叉驗證拆題；docs/local-mode.md 第 4 條）──
# paddle＝本機 PaddleOCR；none＝不做 OCR（只跑視覺模型，交叉驗證停用，所有題都標 vision_only、一律停在人工複核）
# LOCAL_EXTRACT_MODE=ocr 時一定要是 paddle
OCR_ENGINE=paddle
# 跑 ocr_service/ocr_pdf.py 的 Python。不設＝setup_local_ai.bat 建的那一支：
#   Windows：exam_pro\ocr_service\.venv\Scripts\python.exe；其他：exam_pro/ocr_service/.venv/bin/python
#OCR_PYTHON=C:\path\to\python.exe
# PDF 頁面轉圖片的解析度。OCR 的回放檔（cassette）的鍵含這個值，一般不要動
OCR_DPI=200
# 單次 OCR 逾時（毫秒）
OCR_TIMEOUT_MS=1800000
# （加速選項 b，預設不縮）送給視覺模型之前把每頁圖片的長邊縮到這個像素（512～10000；不設或 0＝不縮）。
# 讀圖變快，但小字、上下標、分式可能看不清；OCR 仍用原圖。圖片不在回放檔的鍵裡，改了不必重錄。
# 先量再決定：npm run local:bench-vision -- --max-edge 1600（docs/local-mode.md 第 10.11 條）
#VISION_MAX_EDGE_PX=1600

# ── 備份（scripts/backup.js；四個都有預設值，不設也能跑）──
# BACKUP_DIR=exam_pro/backups        輸出資料夾
# BACKUP_KEEP=14                     保留份數（對應 MySQL 保留 14 天的窗口）
# BACKUP_COPY_DIR=                   額外複製一份到雲端同步資料夾；留空不複製
# BACKUP_PG_SERVICE=postgres         docker compose exec 的服務名

# ── 功能旗標（新功能才放，預設全關；集中在 config/features.js）──
FEATURE_SIMILAR=false
FEATURE_HYBRID_SEARCH=false

# 後端 API 存取金鑰（留空則停用認證；建議自己使用時也設一組）
API_KEY=

# 允許的前端來源（逗號分隔）。留空預設只允許 localhost
# 設了 HOST=0.0.0.0 讓區網連進來時，加上平板打的網址，例：http://localhost:3000,http://192.168.1.23:3000
ALLOWED_ORIGINS=http://localhost:3000

# Word 匯出下載題目圖片時允許的網域（逗號分隔，選填）。
# 留空代表不限制網域，僅套用內建的防 SSRF 檢查（擋掉 localhost 與內網位址）。
IMAGE_HOST_ALLOWLIST=

# 執行環境：development 時錯誤會回傳細節，production 不外洩
NODE_ENV=development

# ══════════════════════════════════════════════════════════════
# 階段 2：Agent 管線（docs/interfaces-stage2.md 第 9 條）
# ══════════════════════════════════════════════════════════════

# ── 模型路由（config/models.js 解析 'vendor:model-id'，只切第一個冒號）──────
# 本機預設（docs/local-mode.md 第 2 條）：拆題用視覺＋文字模型（看頁面圖片），驗算用另一個純文字模型——
# 兩個不同的模型才有交叉檢查的意義（MODEL_VERIFY 與 MODEL_EXTRACT 相同 ID 時 config/models.js 啟動會印警告）。
# 出變式沿用 verify（MODEL_VARIANT 留空時）。
MODEL_EXTRACT=ollama:qwen3-vl:8b
MODEL_VERIFY=ollama:qwen3:8b
# 純文字工作（章節分類、公式重寫、知識點標註、主控助教）的模型（docs/local-mode.md LM-15）。
# 不設＝拆題模型是 ollama 時沿用 MODEL_VERIFY（不必在視覺模型與文字模型之間換載）；Gemini 模式下沿用 MODEL_EXTRACT。
# 切回 Gemini 時若這行有明寫 ollama:…，要一起改掉。
#MODEL_TEXT=ollama:qwen3:8b
# 把 PaddleOCR 的文字整理成拆題 JSON 的模型；不設＝沿用 MODEL_VERIFY
#MODEL_OCR_STRUCTURE=ollama:qwen3:8b
# 切回 Gemini 時的值（ID 由 A-T0 spike 於 2026-08-21 實測；見 interfaces-stage2.md 第 0 條）：
#   MODEL_EXTRACT=gemini:gemini-3.5-flash
#   MODEL_VERIFY=gemini:gemini-3.1-pro-preview（付費層；與拆題不同級才是異級驗證，裁決 S2-29）
#   ⚠ Pro 系列在免費金鑰上不可用（配額為 0）：仍在免費層的話 MODEL_VERIFY 用 gemini:gemini-3.7-flash。
# 〔dec/r13-engine-choice〕上傳考卷、AI 家教、助教可以在畫面上逐次選「本機／Gemini」（docs/local-mode.md 10.26）。
# 選的與上面 .env 的不同時才讀下面四行（都不寫也能用）：
#   選 Gemini：拆題＝GEMINI_MODEL_EXTRACT，驗算／家教＝GEMINI_MODEL_VERIFY；沒寫就是 gemini:gemini-3.5-flash／gemini:gemini-3.1-pro-preview。
#     ⚠ 免費金鑰用不了 Pro：還在免費層就把 GEMINI_MODEL_VERIFY 寫成 gemini:gemini-3.7-flash。要選 Gemini 一定要填上面的 GEMINI_API_KEY。
#   選本機（.env 是 Gemini 時）：LOCAL_MODEL_EXTRACT／LOCAL_MODEL_VERIFY；沒寫就是 ollama:qwen3-vl:8b／ollama:qwen3:8b。
#   向量（EMBED_MODEL）不跟著換；改完 .env 要重啟伺服器。
#GEMINI_MODEL_EXTRACT=gemini:gemini-3.5-flash
#GEMINI_MODEL_VERIFY=gemini:gemini-3.7-flash
#LOCAL_MODEL_EXTRACT=ollama:qwen3-vl:8b
#LOCAL_MODEL_VERIFY=ollama:qwen3:8b
# 預留給 A-T17（異家驗證）；第一版不讀這個變數，留空即可
ANTHROPIC_API_KEY=
# Gemini generateContent 的每分鐘請求上限（services/llm/throttle.js 令牌桶；與 EMBED_RPM 獨立；本機模式不會用到）。
# 免費層實測只有 5（quotaId GenerateRequestsPerMinutePerProjectPerModel-FreeTier），開通付費後再放寬——裁決 S2-16
GEMINI_RPM=5

# ── record/replay cassette（規劃 §5.3.3、裁決 25 於階段 2 定案）───────
# 預設 eval/cassettes（公開層，進版控）；--golden 指到 eval/private/ 時，
# eval/run.js 會在行程內強制改成 eval/private/cassettes，避免真題回應寫進 repo。
EVAL_CASSETTE_DIR=eval/cassettes

# ── worker（workers/jobRunner.js）────────────────────────────────
# inline=跟著 server.js 起（預設）；off=不啟動（測試、純 API 部署、開發時想用獨立視窗跑）
JOB_RUNNER=inline
JOB_POLL_MS=2000
# 同時處理幾份 PDF（這個值也是 LLM 的併發桶上限，services/llm/throttle.js）。
# 本機模式建議 1：CPU 一次只跑得動一個模型，兩個槽只會互相排隊，排隊的時間也算在節點逾時裡。切回 Gemini 可改回 2。
JOB_CONCURRENCY=1
# 租約：runner 在呼叫進行中每 30 秒續租（workers/jobRunner.js），避免另一個並行槽重新認領仍在執行的列；
# 本機模式一個節點可跑到 45 分鐘，靠的是續租而不是把租約拉長（docs/local-mode.md 第 2 條）。
JOB_LEASE_MS=180000
# 單一節點逾時（毫秒）。不設＝依拆題模型：ollama 時 2700000（45 分），其他 120000（2 分）。
# 明寫的值一律優先——所以本範本刻意不寫，換模型時才不必跟著改（docs/local-mode.md 第 2 條）
#JOB_NODE_TIMEOUT_MS=2700000

# ── 預算三層（規劃 §3.3.5）──────────────────────────────────────
# 本機模型的單價一律 0（config/pricing.js），這幾道煞車在本機模式下不會觸頂；切回 Gemini 才有作用。
# 每份 PDF 的上限，建立 job 時複製進 jobs.budget_usd；超線的列一律 needs_review('budget_exceeded')
JOB_COST_BUDGET_USD=0.50
# 全域止血：當日 job_events 的 cost_usd 累計超過就不再認領新 job（API 仍可排隊）
DAILY_COST_BUDGET_USD=5.00

# ── extract 節點（PDF 切塊）─────────────────────────────────────
# 每塊頁數。不設＝依拆題模型：ollama 時 2 頁（CPU 上的視覺模型一次看太多頁很慢，也容易超出上下文），其他 20 頁。
# 明寫的值一律優先——所以本範本刻意不寫（docs/local-mode.md 第 2 條）。
# 〔Owner 決策單 2026-09-26 第四輪 V4〕舊流程 /analyze-pdf 也照這個預設（原本不設時一律 20 頁）。
# （Gemini：spike 實測 PDF 每頁約 532 個 IMAGE token，20 頁約 10.6k token；切塊的理由是失敗重試的粒度與輸出長度）
#JOB_PDF_CHUNK_PAGES=2
# （Gemini 專用）單塊 base64 前的原始位元組超過此值才改走 Files API。
# spike 實測 inlineData 到 50 MB（base64 66 MB）都還被接受，所以這個門檻對齊
# routes/index.js 的 multer 上限（15 MB），實務上不會被觸發——Files API 是備而不用的退路
GEMINI_INLINE_MAX_BYTES=15728640

# ── 閘門閾值 ────────────────────────────────────────────────
# classify 第一層零成本閘門：章節在白名單內且信心 ≥ 此值就直接 pass，不呼叫 LLM
CLASSIFY_MIN_CONF=0.8
# dedup L1（向量）：≥ DUP 視為重複進複核；≥ VARIANT 視為變式，照常入庫但記候選
# 〔Owner 第五輪 V5-3、V5-4、V5-5 核准 2026-09-27〕不寫＝依向量模型（EMBED_MODEL）自動取預設（config/similarityThresholds.js）：
#   本機（ollama:，含 EMBED_MODEL 沒寫）DUP 0.99、VARIANT 0.90；Gemini DUP 0.97、VARIANT 0.90。
#   ⚠ 明寫就一律照寫的值（不分模型）：舊 .env 若還寫著 0.97，換成本機向量後新預設不會生效，要把那一行刪掉。
#   〔審查修正 dec/r6-defaults-fix〕本機向量卻明寫了這些 Gemini 舊值時，伺服器啟動會印一則提醒，點名要刪哪幾行。
#DEDUP_DUP_THRESHOLD=0.99
#DEDUP_VARIANT_THRESHOLD=0.90

# ── 功能旗標 ────────────────────────────────────────────────
# 開啟後前端上傳區改走 POST /api/jobs；關閉時維持舊的 /analyze-pdf + batch-save-questions
FEATURE_PIPELINE=false

# ══════════════════════════════════════════════════════════════
# 階段 3：產品面與 RAG 三落點（docs/interfaces-stage3.md 第 9 條）
# ══════════════════════════════════════════════════════════════

# ── 變式題生成（WS-B）────────────────────────────────────────
# 變式生成用的模型。留空時退回 MODEL_VERIFY（本機模式：ollama:qwen3:8b）。
MODEL_VARIANT=
# 單次 POST /api/questions/:id/variants 最多生幾題（count 的上限）
VARIANT_MAX_PER_REQUEST=3
# 裁決 S3-R9：原本一個 VARIANT_SIM_MIN 兩個用途，但最佳值方向相反（docs/variants.md 第 3 節），拆成兩個：
# 〔Owner 第五輪 V5-1、V5-2、V5-5 核准 2026-09-27〕下面三個（含舊名 VARIANT_SIM_MIN）都改成註解：不寫＝依向量模型自動取預設
#   （config/similarityThresholds.js）。本機（ollama:，含 EMBED_MODEL 沒寫）RETRIEVE 0.72、OFFTOPIC 0.87（暫定，variant 重錄後依 O-4 抽查再定案）；
#   Gemini RETRIEVE 0.80、OFFTOPIC 0.90。⚠ 明寫（或舊 .env 留著 VARIANT_SIM_MIN）就一律照寫的值，新預設不會生效，要刪掉。
#   〔審查修正 dec/r6-defaults-fix〕本機向量卻明寫了這些 Gemini 舊值時，伺服器啟動會印一則提醒，點名要刪哪幾行。
# ① retrieved 分支「夠像」的餘弦下限（Gemini 向量：0.80 時 30 藍本覆蓋率 0.87；拉到 0.92 只剩 0.20。本機向量：0.72 時 15／30）
#VARIANT_RETRIEVE_SIM_MIN=0.72
# ② 生成後的跑題閾值。裁決 S3-R29（2026-08-24）：0.92 → 0.90。
#    0.92 是用 fixture 裡「同概念換數字」的現成題對校準的（餘弦 ≥ 0.93），但那正是只改字閘門（S3-R8）
#    要退回的東西——合格變式必須改寫敘述，實錄 60 題的餘弦多落在 0.85～0.92，0.92 擋掉 26/30 藍本。
#    0.90 時跨章誤收仍只有 0.76%（docs/variants.md 第 3.2 節）。本機向量的 0.87 在 fixture 上與 Gemini 的 0.90 一樣嚴（等效值 0.8671）。
#VARIANT_OFFTOPIC_SIM_MIN=0.87
# 舊名 VARIANT_SIM_MIN 仍被讀作兩者的退路（只在上面兩個都沒設時生效，而且會蓋過依模型的預設），過渡期後移除；不要再寫
#VARIANT_SIM_MIN=0.80
# 只改字閘門：normalize 後的 Levenshtein ratio 低於此值就退回（utils/variantTextGate.js）。
# 刻意不用 embedding 判——embed_text 的設計就是讓「換數字的同一題」碰撞。
VARIANT_MIN_EDIT=0.08
# 變式 job 的 lint 節點重試上限（覆寫 DEFAULT_LIMITS.maxRetries.lint，只影響 kind='variant'）
VARIANT_LINT_RETRIES=2
# 每個變式 job 的成本上限，建立時複製進 jobs.budget_usd（比 PDF 的 0.50 低，一次只生 1~3 題）
VARIANT_TOKEN_BUDGET_USD=0.30
# false = 全部閘門過了仍停在 needs_review('awaiting_approval')，等老師在複核佇列點頭才入庫。
# 首輪一律 false：變式題沒有原卷可對照，比拆題更危險。
VARIANT_AUTO_APPROVE=false

# ── 檢索式 few-shot 分類（WS-B）──────────────────────────────
# kNN 投票短路：前 5 鄰居 ≥4 題人工確認且同章、且最近鄰餘弦 ≥ 此值 → 不呼叫 LLM。
# 只有 chapter_src='human' 的標籤有投票權（'knn'／'ai' 沒有，否則錯一題會自我強化）。
# 〔Owner 第五輪 O-2 核准 2026-09-27〕本機與 Gemini 都維持 0.90（不寫＝0.90，由 config/similarityThresholds.js 決定）。
#KNN_VOTE_SIM=0.90

# ── 自然語言查題（WS-C）──────────────────────────────────────
# 規則沒抓到章節時才呼叫的模型（規則是主路徑，LLM 是輔路徑）。
# ⚠ 不要留空：留空時程式的預設是 Gemini（services/nlqService.js），本機模式下會連外。切回 Gemini：gemini:gemini-3.5-flash
MODEL_NLQ=ollama:qwen3:8b
# LLM 輔路徑的逾時；逾時就退回只用規則的結果（fallback_level=1）。
# 本機 CPU 模型在 4 秒內幾乎回不來＝實際上只用規則；想用 LLM 輔路徑改成 120000（每次查詢要等一兩分鐘）
NLQ_TIMEOUT_MS=4000

# ── 組卷：承上題整組湊不滿題數時（FR-019；〔Owner 決策單 2026-09-25 B10〕）──────
# 承上題一定和前題整組出（例：剩 1 個名額、剩下的題組都是 2 題一組，就湊不出剛好的題數）。
#   error＝直接擋下（回 400），告訴老師哪一章（跨章配額則是哪一列）要幾題、承上題整組最多湊得到幾題、
#         建議把題數改成幾題（例如 N−1 或 N+1 剛好湊得滿）——Owner 決策的預設
#   note ＝照舊少出題，預覽與出卷結果附註實際題數與原因（決策前的行為）
# 未設、空白或打錯字一律當 error（打錯字時伺服器 log 會警告一次）；改了要重啟伺服器才生效。
# 「真的庫存不足」（沒寫過的題本來就不夠）不受這個設定影響。助教的「試算一張卷」也照這個設定。
FOLLOW_UP_SHORTFALL_POLICY=error

# ── 學生弱點面板（WS-A）──────────────────────────────────────
# 已批改題數低於此值的那一列標 low_sample=true，前端顯示「樣本不足」
WEAKNESS_MIN_N=5

# ── 階段 3 的功能旗標（預設全關；集中在 config/features.js）──
# 學生／試卷／批改／弱點五支 API 與「學生」分頁
FEATURE_STUDENTS=false
# POST /api/questions/search-nl 與題庫管理的自然語言查題框
FEATURE_NLQ=false
# POST /api/questions/:id/variants 與變式題進度區
FEATURE_VARIANTS=false
# 階段 4 A1：對話式助教（主控 agent 調度五個只讀工具；會呼叫 LLM＝花錢，預設關）
FEATURE_ASSISTANT=false
# 助教主控用的模型；未設時退回 MODEL_TEXT（本機＝MODEL_VERIFY、Gemini＝MODEL_EXTRACT）
#MODEL_ASSISTANT=ollama:qwen3:8b
# 一輪對話最多幾次工具呼叫（1~10）
ASSISTANT_MAX_STEPS=5

# ── 階段 5 的功能旗標（預設全關；docs/interfaces-stage5.md 第 1.3 條）──
# 知識點分頁與 /api/kc*（瀏覽、審定口語版、手動標註）
FEATURE_KC=false
# 入庫後自動為新題標知識點（會呼叫 LLM＝花錢）
# （WS-C）標註費用只記在 worker log，**不計入** DAILY_COST_BUDGET_USD 的當日累計、也不計入 job 的 budget_usd；
# 但當日花費已達 DAILY_COST_BUDGET_USD 或該 job 預算用盡時，入庫仍照常、標註會略過（之後用 npm run kc:backfill 補）
FEATURE_KC_TAGGING=false
# （WS-C）自動標註的信心門檻：模型給的 confidence ≥ 此值才寫入（src=ai）；非法值退回 0.6
KC_TAG_MIN_CONFIDENCE=0.6
# （WS-C）自動標註用的模型；未設時沿用 MODEL_TEXT（本機＝MODEL_VERIFY、Gemini＝MODEL_EXTRACT；npm run kc:backfill 與入庫掛鉤共用）
#MODEL_KC_TAG=ollama:qwen3:8b
# 依弱點出補救卷（POST /api/students/:id/remedial-paper）與題庫覆蓋率（GET /api/coverage）
# 補救卷區塊在「學生」分頁裡，要同時開 FEATURE_STUDENTS；「找相似 → 加入補救卷」另需 FEATURE_VARIANTS 與 FEATURE_SIMILAR
FEATURE_REMEDIAL=false
# AI 家教：解題、講觀念（Gemini 模式：數值由 code execution 驗算、會花錢；本機模式沒有程式驗算，回答不會宣稱「已驗算」）
FEATURE_TUTOR=false
# 按住說話：錄音轉文字與數學式，老師確認後才送給 AI 家教（需同時開 FEATURE_TUTOR）。
# 本機模式不提供語音：MODEL_VOICE 不是 gemini: 時，即使設 true 也不掛載語音路由（docs/local-mode.md 第 0 條）
FEATURE_VOICE=false

# ── 錯題重練與間隔複習（docs/retrain-and-review.md 第 5.1 節；DEC-003 例外條款、DEC-016）──
# 批改卡的「要重練」勾選、學生頁的「錯題重練」清單與 /api/students/:id/retrain-items、/api/retrain/summary。預設關。
# 開啟時不會補建以前的錯題（Owner 決策單 2026-09-26 R11 選 3）；要的話在清單上以題號手動加入。
# 不呼叫 LLM。關閉時新 API 不掛載；刪卷／刪學生／合併學生時對既有重練資料的處理照樣執行（資料完整性）。
FEATURE_RETRAIN=false
# 以下四個是排程參數（config/retrain.js）；未設或空字串＝預設，非法值退回預設並警告一次。
# 改完重啟，再執行 npm run retrain:recompute，清單上的到期日才會照新參數重排。
# 每一關的間隔天數，逗號分隔（預設 1,7,14：重做→隔 1 週→再隔 2 週；Owner 決策單 2026-09-26 R3 選 2）
#RETRAIN_STEP_DAYS=1,7,14
# 連續答對幾次算練到會（預設 3；R3 選 2）。關數要 ≥ 這個數；改成 4 時 RETRAIN_STEP_DAYS 要給 4 關（例 1,7,14,28）
#RETRAIN_MASTERY_STREAK=3
# 同一題錯幾次標「卡關」提醒（只提醒，仍留在清單、照樣到期；預設 3；R4 選 1）
#RETRAIN_STUCK_LAPSES=3
# 出新卷勾「附上到期的重練題」時預先帶入的上限＝新題數 × 這個比例（無條件捨去，出卷時可改；預設 0.3；R6 選 1）
# 〔PR-3〕組卷頁與補救卷都用它（app.js 注入 <meta name="retrain-attach-ratio">）；補救卷另外不超過 20 題
#RETRAIN_ATTACH_RATIO=0.3

# ── 階段 5 WS-E：AI 家教與按住說話（docs/tutor.md；docs/interfaces-stage5.md 第 4.5、5.2 條）──
# 家教解題用的模型；留空時沿用 MODEL_VERIFY（要推理強：它得自己解題、寫 Python 驗算）
#MODEL_TUTOR=ollama:qwen3:8b
# 語音轉寫用的模型（音訊 → 繁中逐字稿＋LaTeX）；留空時沿用 MODEL_EXTRACT。語音只在 Gemini 模式可用
#MODEL_VOICE=gemini:gemini-3.5-flash
# 家教＋語音**合計**的每日花費上限（美元）。依 config/pricing.js 估算、程序內按本地日期累計，
# 超過就回 429 到隔天（重啟會歸零；0 = 不准花錢）。價目表查不到的模型以表上最貴的單價估。
TUTOR_DAILY_BUDGET_USD=1.0
# POST /api/tutor 每來源每分鐘上限（入口限流；與上面的預算是兩道不同的閘門）
TUTOR_RATE_LIMIT_PER_MIN=10
# POST /api/voice/transcribe 每來源每分鐘上限
VOICE_RATE_LIMIT_PER_MIN=10

# PostgreSQL 容器密碼（docker-compose.yml 的 POSTGRES_PASSWORD；預設 exam）
# 只在資料庫第一次建立時生效；改了要同步改上面 DATABASE_URL 與 TEST_DATABASE_URL 的密碼
# PG_PASSWORD=exam

# 拆題結果對照原卷文字層（docs/source-check.md）：off 不比對／shadow 只記錄不攔／enforce 題幹與原卷不符即進複核
# 未設定、空字串或非法值一律 enforce；runner 建立時讀取，改動須重啟
SOURCE_CHECK_MODE=enforce
