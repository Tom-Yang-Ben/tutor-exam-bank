# 複製此檔為 .env 並填入實際值
# 變數清單的權威版本：階段 1 在 docs/interfaces.md 第 9 條（I0），階段 2 在
# docs/interfaces-stage2.md 第 9 條（I0'）。
# 各 workstream 不要直接改這個檔：需要新變數請寫在 PR 描述裡，由開發者本人合入。
PORT=3000

# Google Gemini API 金鑰
GEMINI_API_KEY=your_gemini_api_key_here

# ── PostgreSQL（階段 1 起的正式資料庫）────────────────────────
# 帳密與埠對應 exam_pro/docker-compose.yml；雙擊 啟動資料庫.bat 就會起這兩個容器。
# 埠是 5442 不是 5432：本機另有一個原生 PostgreSQL 17 服務占用 5432（詳見 docker-compose.yml 註解）。
DATABASE_URL=postgres://exam:exam@localhost:5442/tutor_exam_bank
# 整合測試專用（埠 5433，tmpfs）。防呆：資料庫名必須以 _test 結尾，否則 migrate.js 拒絕執行。
TEST_DATABASE_URL=postgres://exam:exam@localhost:5433/tutor_exam_bank_test

# ── Embedding 與檢索 ────────────────────────────────────────
EMBED_MODEL=gemini-embedding-001
# EMBED_DIM 在 I0 釘死為 768（migrations/0002_vector.sql 寫死 vector(768)）。
# 要改維度＝換模型：必須新開一支 migration + 重建索引 + 全量重算。
EMBED_DIM=768
EMBED_RPM=60
EMBED_BATCH=32
# live=真的呼叫 Gemini／record=呼叫並錄成 fixture／fixture=只查 eval/fixtures（CI 恆為 fixture）
EMBED_MODE=fixture
# live=真的呼叫／record=呼叫並錄 cassette／replay=只回放（CI 恆為 replay）
LLM_MODE=replay

# fixture 向量檔目錄（單元測試會把它指到暫存目錄；一般不用改）
EMBED_FIXTURE_DIR=
# 指到本機 dict.txt.big 才額外載入 jieba 繁體大詞典；預設不啟用（CI 也沒有，兩邊必須一致）
JIEBA_DICT_BIG=

# ── 備份（scripts/backup.js；四個都有預設值，不設也能跑）──
# BACKUP_DIR=exam_pro/backups        輸出資料夾
# BACKUP_KEEP=14                     保留份數（對應 MySQL 保留 14 天的窗口）
# BACKUP_COPY_DIR=                   額外複製一份到雲端同步資料夾；留空不複製
# BACKUP_PG_SERVICE=postgres         docker compose exec 的服務名

# ── 功能旗標（新功能才放，預設全關；集中在 config/features.js）──
FEATURE_SIMILAR=false
FEATURE_HYBRID_SEARCH=false

# 後端 API 存取金鑰（留空則停用認證；建議自己使用時也設一組）
API_KEY=

# 允許的前端來源（逗號分隔）。留空預設只允許 localhost
ALLOWED_ORIGINS=http://localhost:3000

# Word 匯出下載題目圖片時允許的網域（逗號分隔，選填）。
# 留空代表不限制網域，僅套用內建的防 SSRF 檢查（擋掉 localhost 與內網位址）。
IMAGE_HOST_ALLOWLIST=

# 執行環境：development 時錯誤會回傳細節，production 不外洩
NODE_ENV=development

# ══════════════════════════════════════════════════════════════
# 階段 2：Agent 管線（docs/interfaces-stage2.md 第 9 條）
# ══════════════════════════════════════════════════════════════

# ── 模型路由（config/models.js 解析 'vendor:model-id'）────────────────
# ID 由 A-T0 spike 於 2026-08-21 實測當日可用者決定（見 interfaces-stage2.md 第 0 條）：
#   拆題用最新穩定 Flash；驗證用另一個「更新的」Flash，避免同一個 ID 自己驗自己
#   （MODEL_VERIFY 與 MODEL_EXTRACT 相同 ID 時 config/models.js 啟動會印警告）。
# ⚠ Pro 系列在本專案的免費金鑰上不可用：gemini-2.5-pro 對新用戶回 404，
#   gemini-3.1-pro-preview／gemini-pro-latest 的免費層配額為 0（429）。
#   開通付費後把 MODEL_VERIFY 改成 gemini:gemini-3.1-pro-preview 才是真正的異級驗證。
MODEL_EXTRACT=gemini:gemini-3.5-flash
# 2026-08-23 專案已開通付費：MODEL_VERIFY 改用 Pro（與拆題不同級，才是規劃 §3.3.8 的異級驗證；裁決 S2-29）。
# 仍在免費層的話改回 gemini:gemini-3.7-flash（Pro 免費配額為 0）。
MODEL_VERIFY=gemini:gemini-3.1-pro-preview
# 預留給 A-T17（異家驗證）；第一版不讀這個變數，留空即可
ANTHROPIC_API_KEY=
# generateContent 的每分鐘請求上限（services/llm/throttle.js 令牌桶；與 EMBED_RPM 獨立）。
# 免費層實測只有 5（quotaId GenerateRequestsPerMinutePerProjectPerModel-FreeTier），開通付費後再放寬——裁決 S2-16
GEMINI_RPM=5

# ── record/replay cassette（規劃 §5.3.3、裁決 25 於階段 2 定案）───────
# 預設 eval/cassettes（公開層，進版控）；--golden 指到 eval/private/ 時，
# eval/run.js 會在行程內強制改成 eval/private/cassettes，避免真題回應寫進 repo。
EVAL_CASSETTE_DIR=eval/cassettes

# ── worker（workers/jobRunner.js）────────────────────────────────
# inline=跟著 server.js 起（預設）；off=不啟動（測試、純 API 部署、開發時想用獨立視窗跑）
JOB_RUNNER=inline
JOB_POLL_MS=2000
JOB_CONCURRENCY=2
# 租約必須 ≥ JOB_NODE_TIMEOUT_MS + 該節點的退避總和（120000 + 1s+2s+4s = 127 秒），留餘裕給 3 分鐘；
# 呼叫進行中每 30 秒續租，避免另一個並行槽重新認領仍在付費的列
JOB_LEASE_MS=180000
JOB_NODE_TIMEOUT_MS=120000

# ── 預算三層（規劃 §3.3.5）──────────────────────────────────────
# 每份 PDF 的上限，建立 job 時複製進 jobs.budget_usd；超線的列一律 needs_review('budget_exceeded')
JOB_COST_BUDGET_USD=0.50
# 全域止血：當日 job_events 的 cost_usd 累計超過就不再認領新 job（API 仍可排隊）
DAILY_COST_BUDGET_USD=5.00

# ── extract 節點（PDF 切塊）─────────────────────────────────────
# 每塊頁數；spike 實測 PDF 每頁約 532 個 IMAGE token，20 頁約 10.6k token，離上下文上限很遠，
# 切塊的真正理由是「失敗重試的粒度」與輸出長度，不是輸入塞不下
JOB_PDF_CHUNK_PAGES=20
# 單塊 base64 前的原始位元組超過此值才改走 Files API。
# spike 實測 inlineData 到 50 MB（base64 66 MB）都還被接受，所以這個門檻對齊
# routes/index.js 的 multer 上限（15 MB），實務上不會被觸發——Files API 是備而不用的退路
GEMINI_INLINE_MAX_BYTES=15728640

# ── 閘門閾值 ────────────────────────────────────────────────
# classify 第一層零成本閘門：章節在白名單內且信心 ≥ 此值就直接 pass，不呼叫 LLM
CLASSIFY_MIN_CONF=0.8
# dedup L1（向量）：≥ DUP 視為重複進複核；≥ VARIANT 視為變式，照常入庫但記候選
DEDUP_DUP_THRESHOLD=0.97
DEDUP_VARIANT_THRESHOLD=0.90

# ── 功能旗標 ────────────────────────────────────────────────
# 開啟後前端上傳區改走 POST /api/jobs；關閉時維持舊的 /analyze-pdf + batch-save-questions
FEATURE_PIPELINE=false

# ══════════════════════════════════════════════════════════════
# 階段 3：產品面與 RAG 三落點（docs/interfaces-stage3.md 第 9 條）
# ══════════════════════════════════════════════════════════════

# ── 變式題生成（WS-B）────────────────────────────────────────
# 變式生成用的模型。留空時退回 MODEL_VERIFY（推理強、與拆題不同家）。
MODEL_VARIANT=
# 單次 POST /api/questions/:id/variants 最多生幾題（count 的上限）
VARIANT_MAX_PER_REQUEST=3
# 裁決 S3-R9：原本一個 VARIANT_SIM_MIN 兩個用途，但最佳值方向相反（docs/variants.md 第 3 節），拆成兩個：
# ① retrieved 分支「夠像」的餘弦下限（0.80 時 30 藍本覆蓋率 0.87；拉到 0.92 只剩 0.20）
VARIANT_RETRIEVE_SIM_MIN=0.80
# ② 生成後的跑題閾值（0.80 太鬆、跨章誤收 12%；0.92 讓「同概念換數字」全過且擋住跨章，0.93 開始誤殺）
VARIANT_OFFTOPIC_SIM_MIN=0.92
# 舊名 VARIANT_SIM_MIN 仍被讀作兩者的退路（只在上面兩個都沒設時生效），過渡期後移除
VARIANT_SIM_MIN=0.80
# 只改字閘門：normalize 後的 Levenshtein ratio 低於此值就退回（utils/variantTextGate.js）。
# 刻意不用 embedding 判——embed_text 的設計就是讓「換數字的同一題」碰撞。
VARIANT_MIN_EDIT=0.08
# 變式 job 的 lint 節點重試上限（覆寫 DEFAULT_LIMITS.maxRetries.lint，只影響 kind='variant'）
VARIANT_LINT_RETRIES=2
# 每個變式 job 的成本上限，建立時複製進 jobs.budget_usd（比 PDF 的 0.50 低，一次只生 1~3 題）
VARIANT_TOKEN_BUDGET_USD=0.30
# false = 全部閘門過了仍停在 needs_review('awaiting_approval')，等老師在複核佇列點頭才入庫。
# 首輪一律 false：變式題沒有原卷可對照，比拆題更危險。
VARIANT_AUTO_APPROVE=false

# ── 檢索式 few-shot 分類（WS-B）──────────────────────────────
# kNN 投票短路：前 5 鄰居 ≥4 題人工確認且同章、且最近鄰餘弦 ≥ 此值 → 不呼叫 LLM。
# 只有 chapter_src='human' 的標籤有投票權（'knn'／'ai' 沒有，否則錯一題會自我強化）。
KNN_VOTE_SIM=0.90

# ── 自然語言查題（WS-C）──────────────────────────────────────
# 規則沒抓到章節時才呼叫的便宜模型（規則是主路徑，LLM 是輔路徑）
MODEL_NLQ=gemini:gemini-3.5-flash
# LLM 輔路徑的逾時；逾時就退回只用規則的結果（fallback_level=1）
NLQ_TIMEOUT_MS=4000

# ── 學生弱點面板（WS-A）──────────────────────────────────────
# 已批改題數低於此值的那一列標 low_sample=true，前端顯示「樣本不足」
WEAKNESS_MIN_N=5

# ── 階段 3 的功能旗標（預設全關；集中在 config/features.js）──
# 學生／試卷／批改／弱點五支 API 與「學生」分頁
FEATURE_STUDENTS=false
# POST /api/questions/search-nl 與題庫管理的自然語言查題框
FEATURE_NLQ=false
# POST /api/questions/:id/variants 與變式題進度區
FEATURE_VARIANTS=false
