# 複製此檔為 .env 並填入實際值
PORT=3000

# Google Gemini API 金鑰
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL 資料庫
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=tutor_exam_bank

# 後端 API 存取金鑰（留空則停用認證；建議自己使用時也設一組）
API_KEY=

# 允許的前端來源（逗號分隔）。留空預設只允許 localhost
ALLOWED_ORIGINS=http://localhost:3000

# Word 匯出下載題目圖片時允許的網域（逗號分隔，選填）。
# 留空代表不限制網域，僅套用內建的防 SSRF 檢查（擋掉 localhost 與內網位址）。
IMAGE_HOST_ALLOWLIST=

# 執行環境：development 時錯誤會回傳細節，production 不外洩
NODE_ENV=development
