# ───────── 根層級 .gitignore（涵蓋 exam / exam_pro 兩個子專案）─────────

# 環境變數與金鑰（絕對不可進版控）
.env
.env.*
!.env.example

# Node 相依套件
node_modules/

# 上傳暫存檔（保留資料夾結構，不含實際檔案）
uploads/
!uploads/.gitkeep

# 資料庫備份 JSON（含題庫資料，避免外流）
*_backup_*.json

# 維運腳本產出的報告（含題庫題目內容，且可隨時重新產生）
公式健檢報告.html
公式修正預覽.html
公式轉換示範.docx

# 日誌與系統檔
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 編輯器 / 工具的個人設定（因人而異，不共用）
.claude/
.vscode/
.idea/
.mcp.json

# 大型報告素材（影片 / 簡報 / PDF，不適合進 git）
*.mp4
*.pptx
*.pdf
demo_video/
# 公開的自製考卷 fixture（extract／pipeline 的 cassette 要靠它；真實考卷仍被上面的 *.pdf 擋住）——裁決 S2-15
!exam_pro/eval/fixtures/*.pdf

# ───────── WS-B 遷移與維運的產出（含真實題目，絕對不可進版控）─────────
# export_mysql.js / import_pg.js / export_pg_delta.js 的工作目錄
exam_pro/migrate/out/
# scripts/backup.js 的 pg_dump 檔與失敗旗標
exam_pro/backups/

# ───────── 階段 2 Agent 管線：上傳的 PDF 原檔（含真實考卷，絕不可進版控）─────────
# POST /api/jobs 把 PDF 存到 exam_pro/data/jobs/<job_id>.pdf（不放 uploads/，避開
# app.js 的一小時清理）；拆題完成後 worker 會刪檔並把 jobs.pdf_path 清成 NULL。
data/
exam_pro/data/
